{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "com.sunnytranslation/fanbei",
  "title": "翻呗文档翻译",
  "description": "文档翻译：上传 DOCX/PDF/PPTX/XLSX/TXT，指定引擎与目标语言，查询进度并下载成品。支持 ZIP/7Z/RAR 批量包与双语对照、扫描件 OCR。",
  "version": "0.1.0",
  "websiteUrl": "https://trans.sunnytranslation.com",
  "repository": {
    "url": "https://github.com/sunnytranslation/fanbei-mcp",
    "source": "github"
  },
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://trans.sunnytranslation.com/mcp",
      "headers": [
        {
          "name": "Authorization",
          "description": "Bearer token issued by POST https://trans.sunnytranslation.com/trans/api/token (username/password).",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ]
}
